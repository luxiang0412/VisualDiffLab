<Window
    x:Class="VisualDiffLab.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:vm="using:VisualDiffLab.App.ViewModels"
    Title="Visual Diff Lab">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          AutomationProperties.AutomationId="MainRoot"
          AutomationProperties.Name="{Binding [App_WorkspaceName]}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenShortcut_Invoked" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="ExportShortcut_Invoked" />
            <KeyboardAccelerator Key="F" Invoked="FitShortcut_Invoked" />
            <KeyboardAccelerator Key="Number0" Invoked="ActualSizeShortcut_Invoked" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoShortcut_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar x:Name="MainCommandBar"
                    Grid.Row="0"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True"
                    AutomationProperties.Name="{Binding [App_MainCommands]}">
            <AppBarButton x:Name="OpenAButton"
                          Icon="OpenFile"
                          Label="{Binding [Command_OpenA]}"
                          Click="OpenA_Click"
                          AutomationProperties.AutomationId="OpenAButton"
                          AutomationProperties.Name="{Binding [Command_OpenA_Name]}"
                          ToolTipService.ToolTip="{Binding [Command_OpenA_Tip]}" />
            <AppBarButton x:Name="OpenBButton"
                          Icon="OpenFile"
                          Label="{Binding [Command_OpenB]}"
                          Click="OpenB_Click"
                          AutomationProperties.AutomationId="OpenBButton"
                          AutomationProperties.Name="{Binding [Command_OpenB_Name]}"
                          ToolTipService.ToolTip="{Binding [Command_OpenB_Tip]}" />
            <AppBarButton x:Name="SwapButton"
                          Icon="Switch"
                          Label="{Binding [Command_Swap]}"
                          Click="Swap_Click"
                          AutomationProperties.AutomationId="SwapButton"
                          AutomationProperties.Name="{Binding [Command_Swap_Name]}"
                          ToolTipService.ToolTip="{Binding [Command_Swap_Tip]}"
                          IsEnabled="{x:Bind ViewModel.CanSwap, Mode=OneWay}" />
            <AppBarSeparator />
            <AppBarElementContainer>
                <SelectorBar x:Name="ModeSelector"
                             VerticalAlignment="Center"
                             SelectionChanged="ModeSelector_SelectionChanged"
                             AutomationProperties.AutomationId="ModeSelector"
                             AutomationProperties.Name="{Binding [Command_ModesName]}">
                    <SelectorBarItem Text="{Binding [Mode_SideBySide]}"
                                     AutomationProperties.AutomationId="ModeSideBySide"
                                     AutomationProperties.Name="{Binding [Mode_SideBySide_Name]}" />
                    <SelectorBarItem Text="{Binding [Mode_Wipe]}"
                                     AutomationProperties.AutomationId="ModeWipe"
                                     AutomationProperties.Name="{Binding [Mode_Wipe_Name]}" />
                    <SelectorBarItem Text="{Binding [Mode_Overlay]}"
                                     AutomationProperties.AutomationId="ModeOverlay"
                                     AutomationProperties.Name="{Binding [Mode_Overlay_Name]}" />
                    <SelectorBarItem Text="{Binding [Mode_Heatmap]}"
                                     AutomationProperties.AutomationId="ModeHeatmap"
                                     AutomationProperties.Name="{Binding [Mode_Heatmap_Name]}" />
                </SelectorBar>
            </AppBarElementContainer>
            <AppBarSeparator />
            <AppBarButton x:Name="FitButton"
                          Icon="Zoom"
                          Label="{Binding [Command_Fit]}"
                          Click="Fit_Click"
                          AutomationProperties.AutomationId="FitButton"
                          AutomationProperties.Name="{Binding [Command_Fit_Name]}"
                          ToolTipService.ToolTip="{Binding [Command_Fit_Tip]}" />
            <AppBarButton x:Name="ActualSizeButton"
                          Icon="ZoomIn"
                          Label="{Binding [Command_ActualSize]}"
                          Click="ActualSize_Click"
                          AutomationProperties.AutomationId="ActualSizeButton"
                          AutomationProperties.Name="{Binding [Command_ActualSize_Name]}"
                          ToolTipService.ToolTip="{Binding [Command_ActualSize_Tip]}" />
            <AppBarToggleButton x:Name="RegionModeButton"
                                Icon="Crop"
                                Label="{Binding [Command_Regions]}"
                                Click="RegionMode_Click"
                                AutomationProperties.AutomationId="RegionModeButton"
                                AutomationProperties.Name="{Binding [Command_Regions_Name]}"
                                ToolTipService.ToolTip="{Binding [Command_Regions_Tip]}" />
            <AppBarButton x:Name="ExportButton"
                          Icon="Save"
                          Label="{Binding [Command_Export]}"
                          AutomationProperties.AutomationId="ExportButton"
                          AutomationProperties.Name="{Binding [Command_Export_Name]}"
                          ToolTipService.ToolTip="{Binding [Command_Export_Tip]}"
                          IsEnabled="{x:Bind ViewModel.ExportSideBySideButtonEnabled, Mode=OneWay}">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="ExportMenu">
                        <MenuFlyoutItem x:Name="ExportDifferenceMenuItem"
                                        Click="ExportDifference_Click"
                                        AutomationProperties.AutomationId="ExportDifferenceItem"
                                        IsEnabled="{x:Bind ViewModel.ExportDifferenceButtonEnabled, Mode=OneWay}" />
                        <MenuFlyoutItem x:Name="ExportSideBySideMenuItem"
                                        Click="ExportSideBySide_Click"
                                        AutomationProperties.AutomationId="ExportSideBySideItem"
                                        IsEnabled="{x:Bind ViewModel.ExportSideBySideButtonEnabled, Mode=OneWay}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarToggleButton x:Name="InspectorToggleButton"
                                Icon="View"
                                Label="{Binding [Command_Inspector]}"
                                IsChecked="True"
                                Click="InspectorToggle_Click"
                                AutomationProperties.AutomationId="InspectorToggleButton"
                                AutomationProperties.Name="{Binding [Command_Inspector_Name]}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="UndoRegionButton"
                              Icon="Undo"
                              Label="{Binding [Command_UndoRegion]}"
                              Click="UndoRegion_Click"
                              AutomationProperties.AutomationId="UndoRegionButton"
                              AutomationProperties.Name="{Binding [UndoRegion_Name]}"
                              IsEnabled="{x:Bind ViewModel.CanUndoRegion, Mode=OneWay}" />
                <AppBarButton x:Name="ClearButton"
                              Icon="Delete"
                              Label="{Binding [Command_Clear]}"
                              Click="Clear_Click"
                              AutomationProperties.AutomationId="ClearButton"
                              AutomationProperties.Name="{Binding [Command_Clear]}"
                              IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}" />
                <AppBarSeparator />
                <AppBarButton x:Name="ShortcutsButton"
                              Icon="Help"
                              Label="{Binding [Command_Shortcuts]}"
                              Click="Shortcuts_Click"
                              AutomationProperties.AutomationId="ShortcutsButton"
                              AutomationProperties.Name="{Binding [Command_Shortcuts_Name]}" />
                <AppBarButton x:Name="AboutButton"
                              Icon="Help"
                              Label="{Binding [Command_About]}"
                              Click="About_Click"
                              AutomationProperties.AutomationId="AboutButton"
                              AutomationProperties.Name="{Binding [Command_About_Name]}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" x:Name="WorkspaceGrid" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="CanvasHost"
                  Grid.Column="0"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  AllowDrop="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="SingleImageHint"
                         Grid.Row="0"
                         Margin="12,8,12,0"
                         Severity="Informational"
                         IsOpen="{x:Bind ViewModel.ShowSingleImageHint, Mode=OneWay}"
                         IsClosable="False"
                         Message="{x:Bind ViewModel.SingleImageHintText, Mode=OneWay}"
                         AutomationProperties.AutomationId="SingleImageHint" />

                <Grid Grid.Row="1" x:Name="CanvasSurface" AllowDrop="True">
                    <canvas:CanvasControl x:Name="Canvas"
                                          AllowDrop="True"
                                          ClearColor="Transparent"
                                          Draw="Canvas_Draw"
                                          CreateResources="Canvas_CreateResources"
                                          PointerWheelChanged="Canvas_PointerWheelChanged"
                                          PointerPressed="Canvas_PointerPressed"
                                          PointerMoved="Canvas_PointerMoved"
                                          PointerReleased="Canvas_PointerReleased"
                                          PointerCanceled="Canvas_PointerCanceled"
                                          PointerCaptureLost="Canvas_PointerCaptureLost"
                                          DoubleTapped="Canvas_DoubleTapped"
                                          KeyDown="Canvas_KeyDown"
                                          KeyUp="Canvas_KeyUp"
                                          IsTabStop="True"
                                          AutomationProperties.AutomationId="ComparisonCanvas"
                                          AutomationProperties.Name="{Binding [Canvas_Name]}" />

                    <Grid x:Name="EmptyState"
                          AllowDrop="True"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                          Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                          AutomationProperties.AutomationId="EmptyStatePanel">
                        <Rectangle Margin="40"
                                   Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                   StrokeThickness="1"
                                   StrokeDashArray="4 4"
                                   RadiusX="8"
                                   RadiusY="8" />
                        <StackPanel MaxWidth="560"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon Glyph="&#xE8B9;"
                                      FontSize="40"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [Empty_Title]}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock Text="{Binding [Empty_Subtitle]}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0">
                                <Button Content="{Binding [Command_OpenA_Full]}"
                                        Click="EmptyOpenA_Click"
                                        AutomationProperties.AutomationId="EmptyOpenAButton"
                                        AutomationProperties.Name="{Binding [Command_OpenA_Name]}" />
                                <Button Content="{Binding [Command_OpenB_Full]}"
                                        Click="EmptyOpenB_Click"
                                        AutomationProperties.AutomationId="EmptyOpenBButton"
                                        AutomationProperties.Name="{Binding [Command_OpenB_Name]}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="DropOverlay"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Background="#330078D4">
                        <Grid>
                            <Rectangle Margin="28"
                                       Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                       StrokeThickness="2"
                                       StrokeDashArray="6 4"
                                       RadiusX="8"
                                       RadiusY="8" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <FontIcon Glyph="&#xE8E5;" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Drop_Title]}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Drop_Hint]}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="InspectorPanel"
                    Grid.Column="1"
                    Width="336"
                    Visibility="{x:Bind ViewModel.InspectorVisibility, Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    AutomationProperties.AutomationId="InspectorPanel"
                    AutomationProperties.Name="{Binding [Inspector_Name]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0" AutomationProperties.AutomationId="InspectorScrollViewer">
                    <StackPanel Padding="16,14,16,20" Spacing="18">
                        <Grid>
                            <TextBlock Text="{Binding [Inspector_Title]}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button HorizontalAlignment="Right"
                                    Padding="6,2"
                                    Click="InspectorClose_Click"
                                    AutomationProperties.AutomationId="InspectorCloseButton"
                                    AutomationProperties.Name="{Binding [Inspector_Hide_Name]}"
                                    ToolTipService.ToolTip="{Binding [Inspector_Hide]}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [Section_Images]}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnDefinitions="20,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Width="18" Height="18" VerticalAlignment="Top">
                                    <TextBlock Text="A" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.ImageAInfo, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="ImageAInfo" />
                                <Border Grid.Row="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Width="18" Height="18" VerticalAlignment="Top">
                                    <TextBlock Text="B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{x:Bind ViewModel.ImageBInfo, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="ImageBInfo" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CanvasInfo, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [Section_Comparison]}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding [Label_Threshold]}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.ThresholdText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           AutomationProperties.AutomationId="ThresholdValueText" />
                            </Grid>
                            <Slider x:Name="ThresholdSlider"
                                    Minimum="0"
                                    Maximum="64"
                                    StepFrequency="1"
                                    TickFrequency="8"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.ThresholdValue, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsThresholdEnabled, Mode=OneWay}"
                                    AutomationProperties.AutomationId="ThresholdSlider"
                                    AutomationProperties.Name="{Binding [Threshold_Name]}" />
                            <TextBlock Text="{Binding [Label_ThresholdHelp]}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" Margin="0,8,0,0">
                                <TextBlock Text="{Binding [Label_Different]}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.DifferentPixelsText, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="StatDifferentValue" />
                                <TextBlock Grid.Row="1" Text="{Binding [Label_Compared]}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{x:Bind ViewModel.ComparedPixelsText, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="StatComparedValue" />
                                <TextBlock Grid.Row="2" Text="{Binding [Label_Ratio]}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{x:Bind ViewModel.RatioText, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="StatRatioValue" />
                                <TextBlock Grid.Row="3" Text="{Binding [Label_Ignored]}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{x:Bind ViewModel.IgnoredPixelsText, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="StatIgnoredValue" />
                                <TextBlock Grid.Row="4" Text="{Binding [Label_Coverage]}" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text="{x:Bind ViewModel.SizeDifferenceText, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           AutomationProperties.AutomationId="StatCoverageValue" />
                            </Grid>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding [Section_IgnoreRegions]}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.IgnoredPixelsText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddRegionButton"
                                        Content="{Binding [Action_DrawRegion]}"
                                        Click="RegionMode_Click"
                                        AutomationProperties.AutomationId="AddRegionButton"
                                        AutomationProperties.Name="{Binding [DrawRegion_Name]}" />
                                <Button Content="{Binding [Action_Undo]}"
                                        Click="UndoRegion_Click"
                                        AutomationProperties.AutomationId="UndoRegionSideButton"
                                        AutomationProperties.Name="{Binding [UndoRegion_Name]}"
                                        IsEnabled="{x:Bind ViewModel.CanUndoRegion, Mode=OneWay}" />
                            </StackPanel>
                            <ListView x:Name="RegionList"
                                      MaxHeight="190"
                                      SelectionMode="Single"
                                      ItemsSource="{x:Bind ViewModel.Regions, Mode=OneTime}"
                                      SelectedItem="{x:Bind ViewModel.SelectedRegion, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="RegionList"
                                      AutomationProperties.Name="{Binding [RegionList_Name]}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RegionItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,3">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Details}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Padding="7,3"
                                                    Click="DeleteRegion_Click"
                                                    AutomationProperties.Name="{x:Bind DeleteAutomationName}"
                                                    ToolTipService.ToolTip="{x:Bind DeleteToolTip}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.OverlayControlsVisibility, Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding [Label_OverlayOpacity]}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.OverlayOpacityText, Mode=OneWay}"
                                           AutomationProperties.AutomationId="OverlayOpacityValueText" />
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.OverlayOpacityValue, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="OverlayOpacitySlider"
                                    AutomationProperties.Name="{Binding [OverlayOpacity_Name]}" />
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WipeControlsVisibility, Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding [Label_WipePosition]}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.WipePositionText, Mode=OneWay}"
                                           AutomationProperties.AutomationId="WipePositionValueText" />
                            </Grid>
                            <Slider Minimum="2"
                                    Maximum="98"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.WipePositionValue, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="WipePositionSlider"
                                    AutomationProperties.Name="{Binding [WipePosition_Name]}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [Section_Appearance]}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding [Label_Theme]}" />
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <RadioButton x:Name="ThemeSystemRadio"
                                             GroupName="Theme"
                                             Content="{Binding [Theme_System]}"
                                             Checked="ThemeRadio_Checked"
                                             AutomationProperties.AutomationId="ThemeSystemRadio"
                                             AutomationProperties.Name="{Binding [Theme_System]}" />
                                <RadioButton x:Name="ThemeLightRadio"
                                             GroupName="Theme"
                                             Content="{Binding [Theme_Light]}"
                                             Checked="ThemeRadio_Checked"
                                             AutomationProperties.AutomationId="ThemeLightRadio"
                                             AutomationProperties.Name="{Binding [Theme_Light]}" />
                                <RadioButton x:Name="ThemeDarkRadio"
                                             GroupName="Theme"
                                             Content="{Binding [Theme_Dark]}"
                                             Checked="ThemeRadio_Checked"
                                             AutomationProperties.AutomationId="ThemeDarkRadio"
                                             AutomationProperties.Name="{Binding [Theme_Dark]}" />
                            </StackPanel>
                            <TextBlock Text="{Binding [Label_Language]}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <RadioButton x:Name="LanguageSystemRadio"
                                             GroupName="Language"
                                             Content="{Binding [Language_System]}"
                                             Checked="LanguageRadio_Checked"
                                             AutomationProperties.AutomationId="LanguageSystemRadio"
                                             AutomationProperties.Name="{Binding [Language_System]}" />
                                <RadioButton x:Name="LanguageEnglishRadio"
                                             GroupName="Language"
                                             Content="{Binding [Language_English]}"
                                             Checked="LanguageRadio_Checked"
                                             AutomationProperties.AutomationId="LanguageEnglishRadio"
                                             AutomationProperties.Name="{Binding [Language_English]}" />
                                <RadioButton x:Name="LanguageChineseRadio"
                                             GroupName="Language"
                                             Content="{Binding [Language_Chinese]}"
                                             Checked="LanguageRadio_Checked"
                                             AutomationProperties.AutomationId="LanguageChineseRadio"
                                             AutomationProperties.Name="{Binding [Language_Chinese]}" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [Section_Export]}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding [Label_DifferenceOverlay]}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.ExportDifferenceSizeText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.AutomationId="ExportDifferenceSizeText" />
                            </Grid>
                            <Button Content="{Binding [Action_ExportDifference]}"
                                    HorizontalAlignment="Stretch"
                                    Click="ExportDifference_Click"
                                    IsEnabled="{x:Bind ViewModel.ExportDifferenceButtonEnabled, Mode=OneWay}"
                                    AutomationProperties.AutomationId="ExportDifferenceButton"
                                    AutomationProperties.Name="{Binding [ExportDifference_Name]}" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Text="{Binding [Label_SideBySide]}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.ExportSideBySideSizeText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.AutomationId="ExportSideBySideSizeText" />
                            </Grid>
                            <Button Content="{Binding [Action_ExportSideBySide]}"
                                    HorizontalAlignment="Stretch"
                                    Click="ExportSideBySide_Click"
                                    IsEnabled="{x:Bind ViewModel.ExportSideBySideButtonEnabled, Mode=OneWay}"
                                    AutomationProperties.AutomationId="ExportSideBySideButton"
                                    AutomationProperties.Name="{Binding [ExportSideBySide_Name]}" />
                        </StackPanel>

                        <TextBlock Text="{Binding [Hint_CanvasShortcuts]}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                Height="34">
            <Grid Padding="12,0" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           MinWidth="52"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           AutomationProperties.AutomationId="ZoomText" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.DiffSummaryText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           AutomationProperties.AutomationId="DiffSummaryText" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="14"
                                  Height="14"
                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="StatusText" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
